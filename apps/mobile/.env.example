# One set per client build. EXPO_PUBLIC_* values are compiled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Which business the app sells for (organizations.slug). The business needs the mobile_app module.
EXPO_PUBLIC_STORE_SLUG=<slug>
EXPO_PUBLIC_BRAND_COLOR=#2b2a27
# Store listing identity
APP_NAME=Shop name
APP_ID=lk.example.shop
APP_SLUG=example-shop
APP_SCHEME=exampleshop
